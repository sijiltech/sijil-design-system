{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "styles/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@sijil/storybook#build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "stories/**", ".storybook/**", "tsconfig*.json"]
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "stories/**", ".storybook/**", "eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "tests/**", "styles/**", "vitest.config.ts"]
    },
    "test:e2e": {
      "dependsOn": ["build-storybook"],
      "cache": false
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}

